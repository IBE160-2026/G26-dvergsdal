# Settings for the wedding website (AD-14). None of them are needed to run the
# app locally: unset or empty means the safe local default shown in brackets.
# To use them, copy this file to .env (never commit .env) and start with
#   uv run --env-file .env manage.py runserver
# All values below are examples, never real ones.

# "local" or "production", spelled exactly like that; anything else refuses to start. [local]
APP_ENV=local

# Django's debug pages: true or false. [true locally, false in production]
# Production refuses to start with DEBUG=true.
DEBUG=true

# Signing key for sessions, CSRF and the draft cookie. [a fixed key for local use only]
# Production refuses to start without its own long, random key, made with
#   uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Comma-separated host names the site answers to. [localhost,127.0.0.1,[::1] locally, none in production]
# Production refuses to start when this is empty.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
