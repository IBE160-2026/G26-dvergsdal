# The Impeccable launcher is a POSIX sh script; with CRLF line endings sh fails
# on Windows (Git Bash) and macOS/Linux.
.claude/skills/impeccable/scripts/impeccable text eol=lf

# robots.txt is served byte for byte and tested against its exact body, so a
# Windows checkout (core.autocrlf) must not turn its line endings into CRLF.
wedding/templates/wedding/robots.txt text eol=lf
